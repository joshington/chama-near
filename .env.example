# Copy to .env and fill in. NEVER commit .env or share your private key.
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=your-treasury.testnet
NEAR_PRIVATE_KEY=ed25519:...
# Optional. Default is https://test.rpc.fastnear.com for testnet.
# NEAR_RPC_URL=
# yoctoNEAR per minor unit. Default 1e20 means 1000 minor units = 0.1 NEAR.
# YOCTO_PER_MINOR_UNIT=100000000000000000000
# Comma-separated member accounts in rotation order (used by npm run demo:live)
CHAMA_MEMBERS=member1.testnet,member2.testnet,member3.testnet

# --- Web app (npm start) ---
# sim (default, no blockchain) or live (real testnet payouts using the settings above)
# CHAMA_MODE=sim
# PORT=3000
# CHAMA_NAME=Kampala Traders Chama
# --- Optional: reminders written in each member's language by Claude ---
# ANTHROPIC_API_KEY=
# LLM_LANGUAGES=alice.testnet=Luganda,bob.testnet=Swahili
